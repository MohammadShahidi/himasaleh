# TLS uses the Let's Encrypt certificate certbot already issued for the domain (renewed via the
# webroot below; the renewal hook reloads this proxy — see infra/server-setup.sh).
{$DOMAIN}, www.{$DOMAIN} {
	tls /etc/letsencrypt/live/{$DOMAIN}/fullchain.pem /etc/letsencrypt/live/{$DOMAIN}/privkey.pem
	encode zstd gzip

	@www host www.{$DOMAIN}
	redir @www https://{$DOMAIN}{uri} permanent

	handle /api/* {
		reverse_proxy api:4000
	}

	# The service worker must never be served stale, or users keep old app versions.
	@sw path /serwist/sw.js
	header @sw Cache-Control "no-cache"

	handle {
		reverse_proxy web:3000
	}
}

# Plain HTTP: certbot HTTP-01 renewals, everything else goes to HTTPS.
http://{$DOMAIN}, http://www.{$DOMAIN} {
	handle /.well-known/acme-challenge/* {
		root * /var/www/certbot
		file_server
	}
	handle {
		redir https://{$DOMAIN}{uri} permanent
	}
}
