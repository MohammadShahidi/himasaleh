# TLS certificates are obtained and renewed automatically.
{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:4000
	}

	# The service worker must never be served stale, or users keep old app versions.
	@sw path /serwist/sw.js
	header @sw Cache-Control "no-cache"

	handle {
		reverse_proxy web:3000
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
