# Production settings. Copy to infra/.env on the server; never commit the real file.
DOMAIN=example.ir
BRAND_NAME="های مصالح"
POSTGRES_PASSWORD=change-me-long-random

# 32+ random characters each, e.g. `openssl rand -base64 48`
JWT_SECRET=
OTP_PEPPER=

SMS_PRIMARY_PROVIDER=fake
SMS_BACKUP_PROVIDER=none

S3_ENDPOINT=https://s3.example.ir
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PRIVATE=hm-private
S3_BUCKET_PUBLIC=hm-public
S3_PUBLIC_BASE_URL=https://s3.example.ir/hm-public
S3_FORCE_PATH_STYLE=true

# Used by infra/backup.sh
BACKUP_PASSPHRASE=
