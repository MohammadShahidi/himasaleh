# Production settings. Copy to infra/.env on the server; never commit the real file.
DOMAIN=himasaleh.ir
BRAND_NAME="های مصالح"
POSTGRES_PASSWORD=change-me-long-random

# 32+ random characters each, e.g. `openssl rand -base64 48`
JWT_SECRET=
OTP_PEPPER=

SMS_PRIMARY_PROVIDER=fake
# sms.ir (set SMS_PRIMARY_PROVIDER=smsir). Template is defined in the sms.ir panel → «ارسال سریع».
SMS_IR_API_KEY=
SMS_IR_OTP_TEMPLATE_ID=
SMS_IR_OTP_PARAM=Code
SMS_BACKUP_PROVIDER=none

S3_ENDPOINT=https://s3.example.ir
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PRIVATE=hm-private
S3_BUCKET_PUBLIC=hm-public
S3_PUBLIC_BASE_URL=https://s3.example.ir/hm-public
S3_FORCE_PATH_STYLE=true

# Used by infra/backup.sh
BACKUP_PASSPHRASE=

# Set by the deploy workflow (registry host/path and image tag); only needed for manual runs
HM_REGISTRY=
HM_TAG=latest
# sms.ir template ids of the other approved messages (docs/SMS-TEMPLATES.md). Empty = that message is not sent.
SMS_IR_TPL_DRIVER_APPROVED=
SMS_IR_TPL_DRIVER_REJECTED=
SMS_IR_TPL_OWNER_VIDEO_REMINDER=
SMS_IR_TPL_DRIVER_CANCEL_WARNING=
SMS_IR_TPL_NEW_LOAD=

# Push to the Android app. fake = log only. For fcm, put the whole Firebase service-account JSON (one line) in FCM_SERVICE_ACCOUNT_JSON on the server only.
PUSH_PROVIDER=fake
FCM_SERVICE_ACCOUNT_JSON=

# Mobile <-> national ID check (Jibit/Shahkar). manual = the expert decides.
SHAHKAR_PROVIDER=manual
JIBIT_AUTHORIZATION=

# Test-load tool for staff (POST /dev/test-trips). Keep off in production.
ENABLE_DEV_TOOLS=false

# Test server only (needs ENABLE_DEV_TOOLS=true): numbers starting with this prefix get their SMS in memory (read at /dev-otp), never from the real provider.
SMS_TEST_PREFIX=
# Mobiles that get the staff role at start-up (comma-separated). There is no staff management UI before phase 3.
STAFF_BOOTSTRAP_PHONES=
