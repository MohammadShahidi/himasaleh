# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://hm:hm@localhost:5432/hm
JWT_SECRET=dev-only-change-me-please-32chars
OTP_PEPPER=dev-only-otp-pepper-change-me
COOKIE_SECURE=false
